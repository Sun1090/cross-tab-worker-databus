{
  "name": "cross-tab-worker-databus",
  "version": "0.2.1",
  "description": "Framework-agnostic cross-tab data bus with Dedicated/Shared Worker clustering and Centrifuge support.",
  "type": "module",
  "license": "MIT",
  "author": "Sun1090",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sun1090/cross-tab-worker-databus.git"
  },
  "homepage": "https://github.com/Sun1090/cross-tab-worker-databus#readme",
  "bugs": {
    "url": "https://github.com/Sun1090/cross-tab-worker-databus/issues"
  },
  "keywords": [
    "broadcast-channel",
    "cross-tab",
    "data-bus",
    "dedicated-worker",
    "shared-worker",
    "centrifuge",
    "websocket"
  ],
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./centrifuge": {
      "types": "./dist/centrifuge.d.ts",
      "import": "./dist/centrifuge.js"
    },
    "./centrifuge.worker": {
      "types": "./dist/workers/centrifuge.worker.d.ts",
      "default": "./dist/centrifuge.worker.js"
    },
    "./centrifuge.shared.worker": {
      "types": "./dist/workers/centrifuge.shared.worker.d.ts",
      "default": "./dist/centrifuge.shared.worker.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/centrifuge.worker.js",
    "./dist/centrifuge.shared.worker.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "examples": "node scripts/serve-examples.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm check"
  },
  "peerDependencies": {
    "centrifuge": "^5.5.3"
  },
  "peerDependenciesMeta": {
    "centrifuge": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.4",
    "globals": "^17.11.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.14.0"
}
